{
  "manifest_version": 3,
  "name": "Gemini Counter",
  "version": "1.3.0",
  "description": "Muestra tu uso real de Gemini Pro en tiempo real",
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": ["https://gemini.google.com/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["src/usage-fetcher.js", "src/content.js"],
      "css": ["src/styles.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
